// Das Program - Prisma Schema for MySQL
// Run: npm run db:push to sync with your MySQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS TABLE
// ============================================
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  emailVerified DateTime? @map("email_verified")

  // Business Information
  businessName      String?   @map("business_name") @db.Text
  businessLogoUrl   String?   @map("business_logo_url") @db.Text
  businessAddress   String?   @map("business_address") @db.Text
  businessPhone     String?   @map("business_phone")
  businessEmail     String?   @map("business_email")
  businessWebsite   String?   @map("business_website")
  taxId             String?   @map("tax_id")
  vatNumber         String?   @map("vat_number")
  bankDetails       Json?     @map("bank_details")
  defaultCurrency   String    @default("USD") @map("default_currency")
  defaultLanguage   String    @default("en") @map("default_language")

  // Payment Integration
  stripeAccountId String? @map("stripe_account_id")
  paypalEmail     String? @map("paypal_email")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  clients              Client[]
  proposals            Proposal[]
  invoices             Invoice[]
  timeEntries          TimeEntry[]            @relation("UserTimeEntries")
  services             Service[]
  emailLogs            EmailLog[]
  paymentTransactions  PaymentTransaction[]
  followUpSchedules    FollowUpSchedule[]

  @@map("users")
}

// ============================================
// CLIENTS TABLE
// ============================================
model Client {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  name               String
  company            String?
  email              String
  phone              String?
  address            String?  @db.Text
  city               String?
  postalCode         String?  @map("postal_code")
  country            String?
  vatNumber          String?  @map("vat_number")
  languagePreference String   @default("en") @map("language_preference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposals   Proposal[]
  invoices    Invoice[]
  timeEntries TimeEntry[]

  @@index([userId])
  @@index([userId, email])
  @@map("clients")
}

// ============================================
// PROPOSALS TABLE
// ============================================
enum ProposalStatus {
  draft
  sent
  viewed
  signed
  rejected
  expired
}

model Proposal {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  clientId       String         @map("client_id")
  proposalNumber String         @map("proposal_number")
  title          String
  templateId     String?        @map("template_id")
  language       String         @default("en")
  description    String?        @db.Text
  lineItems      Json           @map("line_items")
  subtotal       Decimal        @db.Decimal(12, 2)
  taxRate        Decimal        @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal        @map("tax_amount") @db.Decimal(12, 2)
  discount       Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal        @map("total_amount") @db.Decimal(12, 2)
  currency       String         @default("USD")
  status         ProposalStatus @default(draft)
  validUntil     DateTime?      @map("valid_until") @db.Date

  // Signature
  signedAt      DateTime? @map("signed_at")
  signatureData String?   @map("signature_data") @db.Text
  signerName    String?   @map("signer_name")
  signerEmail   String?   @map("signer_email")

  // Tracking
  viewCount     Int       @default(0) @map("view_count")
  lastViewedAt  DateTime? @map("last_viewed_at")
  pdfUrl        String?   @map("pdf_url") @db.Text
  shareToken    String    @unique @default(uuid()) @map("share_token")
  terms         String?   @db.Text
  notes         String?   @db.Text
  sentAt        DateTime? @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
  @@index([userId, status])
  @@index([shareToken])
  @@map("proposals")
}

// ============================================
// INVOICES TABLE
// ============================================
enum InvoiceStatus {
  draft
  sent
  viewed
  paid
  partially_paid
  overdue
  cancelled
}

enum PaymentMethod {
  stripe
  paypal
  bank_transfer
  cash
  other
}

model Invoice {
  id                      String         @id @default(uuid())
  userId                  String         @map("user_id")
  clientId                String         @map("client_id")
  proposalId              String?        @map("proposal_id")
  invoiceNumber           String         @map("invoice_number")
  templateId              String?        @map("template_id")
  language                String         @default("en")
  lineItems               Json           @map("line_items")
  subtotal                Decimal        @db.Decimal(12, 2)
  taxRate                 Decimal        @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount               Decimal        @map("tax_amount") @db.Decimal(12, 2)
  discount                Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount             Decimal        @map("total_amount") @db.Decimal(12, 2)
  currency                String         @default("USD")
  status                  InvoiceStatus  @default(draft)
  paymentMethod           PaymentMethod? @map("payment_method")
  paymentTerms            String         @default("Net 30") @map("payment_terms")
  paymentInstructions     String?        @map("payment_instructions") @db.Text

  // Dates
  issueDate DateTime @map("issue_date") @db.Date
  dueDate   DateTime @map("due_date") @db.Date

  // Payment
  amountPaid             Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  paidAt                 DateTime? @map("paid_at")
  stripePaymentIntentId  String?   @map("stripe_payment_intent_id")
  paypalOrderId          String?   @map("paypal_order_id")

  // Additional Info
  notes      String? @db.Text
  footerText String? @map("footer_text") @db.Text

  // Tracking
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")
  pdfUrl       String?   @map("pdf_url") @db.Text
  shareToken   String    @unique @default(uuid()) @map("share_token")
  sentAt       DateTime? @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposal            Proposal?            @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  timeEntries         TimeEntry[]
  paymentTransactions PaymentTransaction[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([shareToken])
  @@map("invoices")
}

// ============================================
// TIME ENTRIES TABLE
// ============================================
model TimeEntry {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  clientId        String?   @map("client_id")
  projectName     String?   @map("project_name")
  taskDescription String?   @map("task_description") @db.Text
  hours           Decimal   @db.Decimal(8, 2)
  minutes         Int       @default(0)
  hourlyRate      Decimal?  @map("hourly_rate") @db.Decimal(10, 2)
  totalAmount     Decimal?  @map("total_amount") @db.Decimal(10, 2)
  date            DateTime  @db.Date
  startTime       DateTime? @map("start_time")
  endTime         DateTime? @map("end_time")
  billable        Boolean   @default(true)
  invoiced        Boolean   @default(false)
  invoiceId       String?   @map("invoice_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User     @relation("UserTimeEntries", fields: [userId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, billable])
  @@map("time_entries")
}

// ============================================
// SERVICES TABLE
// ============================================
model Service {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  unit        String   @default("hour")
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  category    String?
  active      Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, active])
  @@map("services")
}

// ============================================
// EMAIL LOGS TABLE
// ============================================
enum DocumentType {
  proposal
  invoice
}

enum EmailStatus {
  sent
  delivered
  opened
  clicked
  bounced
  failed
}

model EmailLog {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  documentType   DocumentType @map("document_type")
  documentId     String       @map("document_id")
  proposalId     String?      @map("proposal_id")
  invoiceId      String?      @map("invoice_id")
  recipientEmail String       @map("recipient_email")
  recipientName  String?      @map("recipient_name")
  subject        String
  message        String?      @db.Text
  resendEmailId  String?      @map("resend_email_id")
  status         EmailStatus  @default(sent)

  sentAt      DateTime  @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  openedAt    DateTime? @map("opened_at")
  clickedAt   DateTime? @map("clicked_at")
  failedReason String?  @map("failed_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, documentType, documentId])
  @@map("email_logs")
}

// ============================================
// PAYMENT TRANSACTIONS TABLE
// ============================================
enum PaymentProvider {
  stripe
  paypal
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

model PaymentTransaction {
  id                    String            @id @default(uuid())
  userId                String            @map("user_id")
  invoiceId             String            @map("invoice_id")
  paymentProvider       PaymentProvider   @map("payment_provider")
  transactionId         String            @unique @map("transaction_id")
  amount                Decimal           @db.Decimal(12, 2)
  currency              String
  status                TransactionStatus @default(pending)
  paymentMethodDetails  Json?             @map("payment_method_details")
  feeAmount             Decimal?          @map("fee_amount") @db.Decimal(12, 2)
  netAmount             Decimal?          @map("net_amount") @db.Decimal(12, 2)

  paidAt     DateTime? @map("paid_at")
  refundedAt DateTime? @map("refunded_at")
  metadata   Json?

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([invoiceId])
  @@map("payment_transactions")
}

// ============================================
// FOLLOW UP SCHEDULES TABLE
// ============================================
enum ScheduleStatus {
  pending
  sent
  cancelled
}

model FollowUpSchedule {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  documentType DocumentType   @map("document_type")
  documentId   String         @map("document_id")
  scheduledAt  DateTime       @map("scheduled_at")
  sentAt       DateTime?      @map("sent_at")
  status       ScheduleStatus @default(pending)
  emailSubject String?        @map("email_subject")
  emailBody    String?        @map("email_body") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, scheduledAt])
  @@map("follow_up_schedules")
}
