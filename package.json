{
  "name": "das-program",
  "version": "1.0.0",
  "description": "AI-powered proposal and invoice generator for freelancers and agencies",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 prisma generate && next build",
    "start": "prisma db push --skip-generate --accept-data-loss && next start",
    "start:prod": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "postinstall": "cross-env PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
