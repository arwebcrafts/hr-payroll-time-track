# ============================================
# DATABASE (MySQL + Prisma)
# ============================================
# Required for Prisma
DATABASE_URL="mysql://username:password@localhost:3306/das_program"

# Example for PlanetScale (recommended for production):
# DATABASE_URL="mysql://username:password@aws.connect.psdb.cloud/das_program?ssl accept=strict"

# Example for local MySQL:
# DATABASE_URL="mysql://root:password@localhost:3306/das_program"

# ============================================
# AUTHENTICATION (NextAuth.js)
# ============================================
# Required
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-random-secret-here-use-openssl-rand-base64-32"

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================
# AI PROPOSAL GENERATION (Optional)
# ============================================
# Get from: https://console.anthropic.com
# If not set, uses template-based fallback
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# ============================================
# EMAIL SENDING (Optional)
# ============================================
# Get from: https://resend.com
# Required for sending proposal/invoice emails
RESEND_API_KEY="re_your-key-here"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ============================================
# PAYMENT PROCESSING (Optional - Not Yet Implemented)
# ============================================
# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-key"
STRIPE_SECRET_KEY="sk_test_your-key"
STRIPE_WEBHOOK_SECRET="whsec_your-secret"

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-client-id"
PAYPAL_CLIENT_SECRET="your-secret"
PAYPAL_WEBHOOK_ID="your-webhook-id"

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file to .env (not .env.local - Prisma needs .env)
#    cp .env.example .env
#
# 2. Update DATABASE_URL with your MySQL connection string
#
# 3. Generate NEXTAUTH_SECRET:
#    openssl rand -base64 32
#
# 4. Install dependencies:
#    npm install
#
# 5. Push database schema:
#    npm run db:push
#
# 6. Start development server:
#    npm run dev
#
# 7. (Optional) Add API keys for AI and email features
#
# For complete setup guide, see: MYSQL_MIGRATION.md
